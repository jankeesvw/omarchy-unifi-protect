#!/usr/bin/env bash
# unifi-protect — read UniFi Protect cameras, for the bar widget to call.
#
#   unifi-protect list             # {"ok":true,"cameras":[{"id":..,"name":..,"connected":..}]}
#   unifi-protect snapshot <id>    # writes a JPEG, prints its path
#   unifi-protect capture <id> [name]
#                                  # files a snapshot in the archive; with a
#                                  # name it also raises a desktop notification
#   unifi-protect events [n]       # lists the archive, newest first
#   unifi-protect stream <id>      # prints the RTSP url of the live stream
#   unifi-protect live <id>        # opens the live RTSPS stream in mpv
#   unifi-protect watch            # streams motion as NDJSON, one event per line
#   unifi-protect status           # {ok, hasKey, trusted, host} — no network
#   unifi-protect set-key          # writes a key from stdin to the key file
#   unifi-protect trust            # pins the gateway's certificate; run once
#   unifi-protect trust show       # the live certificate, as JSON; no writes
#   unifi-protect trust accept <fp>
#                                  # pins that fingerprint after re-fetching
#   unifi-protect setup            # a python with websockets for motion, if
#                                  # your distro has no package for it
#
# Options, before the command:
#   --host <host>        gateway address        (default 192.168.1.1)
#   --rtsp-port <port>   plain RTSP port        (default 7447)
#   --archive-keep <n>   frames kept per camera (default 60)
#   --viewer <command>   opens the frame when the notification is clicked
#                        (default "xdg-open {path}")
#
# Everything goes through the Protect integration API, which takes a plain
# X-API-KEY header. That is the whole reason this script is short: the older
# /proxy/protect/api routes want a session cookie, which means a login with a
# TOTP code and a cookie jar that expires after a month. The key does not
# expire and needs no second factor.
#
# Make one at https://<gateway>/unifi-api/protect. Note that UniFi hands a key
# the full rights of the account that created it; there is no way to scope it
# down to Protect over the API.
#
# The key is read from UNIFI_API_KEY, and failing that from the key file --
# see `key()` below.
#
# Because that key is worth as much as the account behind it, nothing here
# talks to the gateway without a pinned certificate. The first connection
# files whatever is answering (trust on first use); later ones have to
# present that same key or they are dropped before the header goes out.
# The gateway signs its own certificate, so there is no chain to check it
# against and no authority to ask. `unifi-protect trust` is still there if
# you would rather look at the fingerprint yourself first. Without a pin
# the -k every one of these calls needs would hand the key to whatever
# answered.

set -uo pipefail

# Frames are pictures of the inside of your house, and the archive keeps them
# for as long as you leave it there. Nothing written below is meant to be read
# by another account on this machine, so the umask says so once rather than
# every mkdir and every redirect repeating it.
umask 077

HOST="${UNIFI_HOST:-192.168.1.1}"
RTSP_PORT="${UNIFI_RTSP_PORT:-7447}"
ARCHIVE_KEEP="${UNIFI_ARCHIVE_KEEP:-60}"
# What a click on the motion notification runs. {path} is the frame that was
# just filed; a command without the placeholder gets the path appended. Empty
# means the notification stays inert.
VIEWER_DEFAULT='xdg-open {path}'
VIEWER="${UNIFI_VIEWER-$VIEWER_DEFAULT}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)         HOST="${2:-}"; shift 2 ;;
    --rtsp-port)    RTSP_PORT="${2:-}"; shift 2 ;;
    --archive-keep) ARCHIVE_KEEP="${2:-}"; shift 2 ;;
    --viewer)       VIEWER="${2:-}"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

API="https://$HOST/proxy/protect/integration/v1"
TIMEOUT=8
SNAPSHOT_TIMEOUT=20
# Where a frame waits for the widget to load it. XDG_RUNTIME_DIR is already a
# directory of our own, mode 700 and cleaned up at logout. /tmp is not: it is
# shared, world-writable ground, so the fallback takes a name of its own per
# user and is checked before it is written to -- see private_dir.
CACHE_DIR="${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/unifi-protect}"
CACHE_DIR="${CACHE_DIR:-/tmp/unifi-protect-$(id -u)}"
# The archive outlives a reboot, so it lives in state rather than runtime.
ARCHIVE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/unifi-protect/events"
KEY_FILE="${UNIFI_API_KEY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/unifi-protect/api-key}"
# The gateway's certificate, filed on first contact or by `unifi-protect trust`.
CERT_FILE="${UNIFI_CERT_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/unifi-protect/gateway.pem}"

# Where `unifi-protect setup` puts a python for the motion watcher, on a
# machine whose distro has no websockets package. Nothing is ever installed
# without being asked for; see the setup command.
VENV_DIR="${UNIFI_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/unifi-protect/venv}"
VENV_PYTHON="$VENV_DIR/bin/python"
# Seconds within which a second request for the same camera is answered with
# the frame already on disk.
ARCHIVE_DEBOUNCE=15
# How long the notification stays up, in milliseconds.
NOTIFY_TIMEOUT=8000

fail() {
  printf '{"ok":false,"error":"%s"}\n' "$1"
  exit 1
}

# The argv a click on the notification runs, with the frame filled in. Fills
# the array named by $1.
#
# VIEWER is a command template, so splitting it on whitespace is the point:
# those words are the user's own configuration. The frame path is data and
# lands in exactly one element whatever is in it, which is why nothing here
# quotes for a shell. The notification server runs the vector as positional
# parameters and never re-parses it.
viewer_argv() {
  local -n argv_ref=$1
  local path=$2
  local -a words=()
  local word filled=0

  read -ra words <<<"$VIEWER"
  argv_ref=()
  for word in "${words[@]}"; do
    if [[ "$word" == *"{path}"* ]]; then
      argv_ref+=("${word//\{path\}/$path}")
      filled=1
    else
      argv_ref+=("$word")
    fi
  done
  ((filled)) || argv_ref+=("$path")
}

# The key, from the environment if it is there, otherwise from the key file.
#
# The environment is the quicker of the two and needs nothing on disk, but it
# only reaches the shell after the next login, so a key file is what makes the
# widget work the moment you have installed it. The file is the key and
# nothing else: the first line with something on it, trimmed. No comment
# syntax, because a key is free to contain any character a comment marker
# would eat.
key() {
  if [[ -n "${UNIFI_API_KEY:-}" ]]; then
    printf '%s' "$UNIFI_API_KEY"
    return
  fi

  [[ -r "$KEY_FILE" ]] || return
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n "$line" ]] || continue
    printf '%s' "$line"
    return
  done < "$KEY_FILE"
}

# Camera ids arrive over the network -- from the listing, and from the motion
# websocket -- and are then spliced into filenames, globs and lock paths. A
# Protect id is flat alphanumeric, so anything else is refused outright rather
# than escaped: a value carrying a slash or a dot is not an id that needs
# cleaning up, it is a sign that what is on the other end is not Protect.
#
# The flat alphabet also keeps `events` honest, which reads the camera back
# out of the filename by splitting on the dash.
valid_id() {
  [[ "$1" =~ ^[A-Za-z0-9]{1,64}$ ]]
}

check_id() {
  valid_id "${1:-}" || fail "not a camera id"
}

# Makes a directory that is ours, and refuses one that is not.
#
# In a shared directory anybody can get there first. A symlink left under the
# name we are about to use would have curl write the frame wherever it points,
# and a directory left readable would let the snapshots be read by whoever
# made it. `mkdir -p` is no defence against either: it follows a symlink to a
# directory and reports success, and it leaves the mode of a directory that
# already existed alone.
#
# So the check comes after, and it looks at the path itself rather than at
# what it resolves to: a symlink here is refused outright instead of being
# followed to something that would pass.
private_dir() {
  local dir="$1" owner mode
  mkdir -p -m 700 -- "$dir" 2>/dev/null
  [[ -d "$dir" && ! -L "$dir" ]] || return 1
  owner="$(stat -c '%u' -- "$dir" 2>/dev/null)" || return 1
  [[ "$owner" == "$(id -u)" ]] || return 1

  # An archive filed by an earlier version of this script is still sitting
  # there readable, and closing the door now does nothing about what is
  # already inside. So the first run that finds it open puts both right --
  # once, because after that the mode already says 700 and there is nothing
  # to walk.
  mode="$(stat -c '%a' -- "$dir" 2>/dev/null)"
  if [[ "$mode" != "700" ]]; then
    chmod 700 -- "$dir" 2>/dev/null || return 1
    find "$dir" -maxdepth 1 -type f -exec chmod 600 -- {} + 2>/dev/null
  fi
}

# Protect answers the stream call with rtsps://<host>:<port>/<alias>, and both
# commands that use it hand the answer to something that reads more than a URL
# out of it: mpv takes a leading dash as an option, and the widget is given the
# alias as part of a path. A value that is not shaped like that stream URL is
# refused rather than repaired -- as with a camera id, it is not a URL in need
# of cleaning up, it is a sign that what answered is not Protect.
valid_stream_url() {
  [[ "$1" =~ ^rtsps?://[A-Za-z0-9.:_-]+/[A-Za-z0-9._~-]+(\?[A-Za-z0-9._~=\&-]*)?$ ]]
}

# Keeping the key out of the arguments is worth nothing if the shell prints it
# anyway. `bash -x` traces the words of every command it runs, so a debug run
# of this script writes the key to stderr -- and stderr is exactly what the
# shell hands to the journal when the widget runs this. So the trace goes off
# around each of the three places that hold the key, and back afterwards to
# whatever it was.
TRACED=0
untrace() { case "$-" in *x*) TRACED=1; set +x ;; *) TRACED=0 ;; esac; }
retrace() { (( TRACED )) && set -x; return 0; }

untrace
KEY="$(key)"
retrace

# The key goes to curl on stdin rather than in an argument, and a quote or a
# backslash would end that line early and turn the rest of the key into curl
# options -- a `user = "..."` of the sender's choosing, say, or a second
# header. A Protect key is drawn from this set, so a key that is not is not a
# key worth sending anywhere. Checked in require_key rather than here:
# status, set-key and trust have to run with no key on file yet.
valid_key() {
  [[ "$1" =~ ^[A-Za-z0-9._~+/=-]+$ ]]
}

# The SHA-256 of the pinned certificate's public key, in the form curl wants.
# Read off the first certificate in the file, which is the gateway's own.
spki() {
  openssl x509 -in "$1" -pubkey -noout 2>/dev/null \
    | openssl pkey -pubin -outform der 2>/dev/null \
    | openssl dgst -sha256 -binary 2>/dev/null \
    | base64 | tr -d '\n'
}

# Every call that carries the key goes through this first. Resolved in the
# main shell rather than lazily inside api(), which runs in a subshell where
# an exit would be reported back as nothing more than an unreachable gateway.
require_key() {
  [[ -n "$KEY" ]] || fail "no API key: set UNIFI_API_KEY or write one to $KEY_FILE"
  valid_key "$KEY" || fail "malformed API key: set UNIFI_API_KEY or write one to $KEY_FILE"
}

PIN=""
require_pin() {
  [[ -n "$PIN" ]] && return
  if [[ -r "$CERT_FILE" ]]; then
    PIN="$(spki "$CERT_FILE")"
    [[ -n "$PIN" ]] && return
  fi
  auto_pin
}

# -k is still here and still cannot go: the certificate names the console, not
# the address you reach it on, so neither the chain nor the hostname will ever
# check out. --pinnedpubkey is enforced anyway -- curl checks the pin whether
# or not verification was switched off -- so what is actually required of the
# far end is that it holds the key of the certificate you pinned. Anything
# else, including a gateway whose certificate was replaced behind your back,
# gets the connection dropped before the header goes out.
CURL_TLS=()
tls_args() {
  require_pin
  CURL_TLS=(-k --pinnedpubkey "sha256//$PIN")
}

# Every request that carries the key goes through here. The key rides in on
# stdin instead of in the arguments: /proc/PID/cmdline is mode 444 on a stock
# kernel -- no hidepid -- so every argument of every running process is
# readable by any account on the machine, and a widget that polls reopens that
# window on a loop. curl reads a `header` line from --config exactly as it
# reads -H, and nobody else gets to read this stdin.
curl_key() {
  local status
  untrace
  printf 'header = "X-API-KEY: %s"\n' "$KEY" \
    | curl -s "${CURL_TLS[@]}" --config - "$@"
  status=$?
  retrace
  return "$status"
}

api() {
  tls_args
  curl_key -m "$TIMEOUT" "$API$1"
}

# --host may already carry a port, in which case that is the one to look at.
gateway_target() {
  local target="$HOST"
  [[ "$target" == *:* ]] || target="$HOST:443"
  printf '%s' "$target"
}

# The certificate chain currently answering on the gateway, PEM, leaf first.
fetch_chain() {
  openssl s_client -connect "$1" -showcerts </dev/null 2>/dev/null \
    | sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p'
}

# First time we talk to this address: file whatever is answering, then pin
# to it. Later calls that already have a pin keep that pin; a certificate
# that no longer matches is a refused connection, not a rewrite.
auto_pin() {
  command -v openssl >/dev/null 2>&1 || fail "openssl is needed to talk to the gateway"
  local target chain
  target="$(gateway_target)"
  chain="$(fetch_chain "$target")"
  [[ -n "$chain" ]] || fail "cannot reach https://$target/ to read its certificate"
  private_dir "${CERT_FILE%/*}" || fail "cannot write ${CERT_FILE%/*}"
  printf '%s\n' "$chain" > "$CERT_FILE" || fail "cannot write $CERT_FILE"
  chmod 600 -- "$CERT_FILE" || fail "cannot write $CERT_FILE"
  PIN="$(spki "$CERT_FILE")"
  [[ -n "$PIN" ]] || fail "that is not a certificate"
}

# SHA-256 fingerprint of the first certificate on stdin, openssl's colon form.
cert_fingerprint() {
  openssl x509 -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2-
}

file_fingerprint() {
  openssl x509 -in "$1" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2-
}

# Hex only, uppercase, so "AA:BB" and "aabb" compare equal. A pasted
# "SHA256 Fingerprint=..." line has its label stripped first, because those
# words themselves contain hex digits.
normalize_fp() {
  local s="$1"
  s="${s##*[Ff]ingerprint=}"
  printf '%s' "$s" | tr '[:lower:]' '[:upper:]' | tr -d ' \t:'
}

case "${1:-list}" in
  list)
    require_key
    tls_args
    body="$(api /cameras)" || fail "unreachable"
    [[ -n "$body" ]] || fail "unreachable"
    printf '%s' "$body" | jq -c '
      if type == "array" then
        {ok: true, cameras: [.[] | {id, name, connected: (.state == "CONNECTED")}]}
      else
        {ok: false, error: (.error.message // "unexpected response")}
      end' 2>/dev/null || fail "bad response"
    ;;

  snapshot)
    id="${2:-}"
    [[ -n "$id" ]] || fail "usage: unifi-protect snapshot <camera-id>"
    check_id "$id"
    require_key
    tls_args
    private_dir "$CACHE_DIR" || fail "$CACHE_DIR is not a directory of ours"

    # A fresh filename every time. QML's Image caches by URL, so overwriting
    # one path would leave the widget showing the first frame forever; a new
    # name means the source changes and the picture actually updates.
    out="$CACHE_DIR/$id-$(date +%s%3N).jpg"
    code="$(curl_key -m "$SNAPSHOT_TIMEOUT" \
      -o "$out" -w '%{http_code}' "$API/cameras/$id/snapshot")"

    if [[ "$code" != "200" || ! -s "$out" ]]; then
      rm -f -- "$out"
      fail "snapshot failed (http $code)"
    fi

    # Keep the two newest frames per camera: one being shown, one just
    # written. Anything older is a file QML is done with.
    # shellcheck disable=SC2012
    ls -t -- "$CACHE_DIR/$id-"*.jpg 2>/dev/null | tail -n +3 | while read -r old; do
      rm -f -- "$old"
    done

    printf '%s\n' "$out"
    ;;

  capture)
    id="${2:-}"
    # A display name turns this into a notification as well. It is passed in
    # rather than looked up so that filing a frame stays one HTTP call.
    name="${3:-}"
    [[ -n "$id" ]] || fail "usage: unifi-protect capture <camera-id> [name]"
    check_id "$id"
    require_key
    tls_args
    private_dir "$ARCHIVE_DIR" || fail "$ARCHIVE_DIR is not a directory of ours"

    # There is one bar per monitor and each runs its own copy of the widget,
    # so the same motion asks for a capture more than once. Whoever asks
    # second gets the frame the first one filed rather than a near-duplicate.
    #
    # Behind a lock, because the two arrive within milliseconds of each other
    # and a snapshot takes a third of a second: without it both would look,
    # both would see nothing recent, and both would file a frame and raise a
    # notification. The second one waits here and then finds the first one's
    # work below.
    exec 9>"$ARCHIVE_DIR/.$id.lock"
    flock 9

    now="$(date +%s)"
    # shellcheck disable=SC2012
    newest="$(ls -t -- "$ARCHIVE_DIR/$id-"*.jpg 2>/dev/null | head -1)"
    if [[ -n "$newest" ]]; then
      newest_ts="${newest##*-}"
      newest_ts="${newest_ts%.jpg}"
      if [[ "$newest_ts" =~ ^[0-9]+$ ]] && (( now - newest_ts < ARCHIVE_DEBOUNCE )); then
        # No notification on this path on purpose: the second bar asking for
        # the same motion must not raise a second popup.
        printf '%s\n' "$newest"
        exit 0
      fi
    fi

    tmp="$ARCHIVE_DIR/.$id.tmp.jpg"
    out="$ARCHIVE_DIR/$id-$now.jpg"
    code="$(curl_key -m "$SNAPSHOT_TIMEOUT" \
      -o "$tmp" -w '%{http_code}' "$API/cameras/$id/snapshot")"

    if [[ "$code" != "200" || ! -s "$tmp" ]]; then
      rm -f -- "$tmp"
      fail "capture failed (http $code)"
    fi

    # Stored small. A full snapshot is 750 KB and the archive is browsed as
    # thumbnails, so keeping them at camera resolution would spend a hundred
    # megabytes to show pictures a few hundred pixels wide.
    if command -v magick >/dev/null 2>&1; then
      magick "$tmp" -resize 960x -quality 82 "$out" 2>/dev/null || mv -- "$tmp" "$out"
      rm -f -- "$tmp"
    else
      mv -- "$tmp" "$out"
    fi

    # shellcheck disable=SC2012
    ls -t -- "$ARCHIVE_DIR/$id-"*.jpg 2>/dev/null | tail -n +$((ARCHIVE_KEEP + 1)) | while read -r old; do
      rm -f -- "$old"
    done

    if [[ -n "$name" ]] && command -v omarchy-notification-send >/dev/null 2>&1; then
      # The frame itself is the icon, so the notification answers "who" rather
      # than only "something moved".
      #
      # An icon is a thumbnail, though, and the thing you want when something
      # moved is a good look at it. Clicking the popup opens the same frame
      # full size: --exec hands the shell's notification server an argv vector,
      # which it stores with the toast and runs on click. A libnotify action
      # would be the portable way to say this, but the sender has to stay alive
      # to receive one, and this script is over in a third of a second.
      #
      # omarchy-notification-send rather than notify-send because only it can
      # carry the click action, and because it speaks to the bus directly: a
      # camera name is Protect's, and notify-send would read one that opens
      # with a dash as an option.
      viewer=()
      [[ -n "$VIEWER" ]] && viewer_argv viewer "$out"

      # --exec last, and only when there is one: it consumes the rest of the
      # line, and an empty vector would make it consume nothing and error.
      send=(omarchy-notification-send -t "$NOTIFY_TIMEOUT" -i "$out"
        --app-name "Camera" "Motion at $name" "$(date '+%H:%M')")
      ((${#viewer[@]})) && send+=(--exec "${viewer[@]}")
      "${send[@]}" 2>/dev/null || true
    fi

    printf '%s\n' "$out"
    ;;

  events)
    # Newest first, so the panel can take the head of the list and stop.
    if [[ ! -d "$ARCHIVE_DIR" ]]; then
      printf '{"ok":true,"events":[]}\n'
      exit 0
    fi
    # shellcheck disable=SC2012
    ls -t -- "$ARCHIVE_DIR"/*.jpg 2>/dev/null | head -n "${2:-24}" | jq -R -s -c '
      {ok: true, events: [
        split("\n") | .[] | select(length > 0) |
        {path: .} + (
          (. | split("/") | last | rtrimstr(".jpg") | split("-")) as $parts |
          {camera: $parts[0], ts: ($parts[1] | tonumber)}
        )
      ]}'
    ;;

  stream)
    id="${2:-}"
    [[ -n "$id" ]] || fail "usage: unifi-protect stream <camera-id>"
    check_id "$id"
    require_key
    tls_args
    url="$(api "/cameras/$id/rtsps-stream" | jq -r '.high // .medium // .low // empty')"
    [[ -n "$url" ]] || fail "no stream for camera $id"
    valid_stream_url "$url" || fail "not a stream url"

    # Protect hands out an rtsps:// URL on 7441, secured with the gateway's
    # self-signed certificate. Qt Multimedia gives no way to skip that check,
    # so this rewrites it to the plain rtsp:// port, which carries the same
    # stream unencrypted. That is LAN traffic to your own gateway; `live`
    # keeps the encrypted URL because mpv can be told to accept the
    # certificate.
    alias="${url##*/}"
    printf 'rtsp://%s:%s/%s\n' "$HOST" "$RTSP_PORT" "${alias%%\?*}"
    ;;

  live)
    id="${2:-}"
    [[ -n "$id" ]] || fail "usage: unifi-protect live <camera-id>"
    check_id "$id"
    require_key
    tls_args
    url="$(api "/cameras/$id/rtsps-stream" | jq -r '.high // .medium // .low // empty')"
    [[ -n "$url" ]] || fail "no stream for camera $id"
    valid_stream_url "$url" || fail "not a stream url"

    # The gateway serves a self-signed certificate, so certificate checking is
    # the one thing that has to give; the stream itself stays encrypted. mpv's
    # own --tls-verify only covers https, hence the libavformat option. Note
    # that nothing on this connection is the API key: the url Protect just
    # handed back carries a per-camera stream alias and nothing else.
    #
    # -- because everything after it is a file to play. The URL is Protect's
    # answer, not ours, and mpv reads a leading dash as an option -- one of
    # which loads a script off disk. The check above already refuses anything
    # that is not a stream URL; the terminator means a hole in that pattern
    # still does not become an argument list.
    exec mpv --title="UniFi camera" \
      --rtsp-transport=tcp --demuxer-lavf-o=tls_verify=0 \
      --profile=low-latency --no-terminal -- "$url"
    ;;

  watch)
    # Motion arrives over a websocket, which bash cannot speak, so this one
    # subcommand borrows python. It prints one JSON object per line and runs
    # until killed, which is what Quickshell's SplitParser wants to read.
    #
    # The connection must be HTTP/1.1: over HTTP/2 the gateway answers the
    # upgrade with a 404 rather than refusing it, which looks exactly like a
    # missing endpoint. websockets does 1.1, so this is only a trap when
    # testing by hand with curl.
    require_key
    tls_args
    # The key goes in on a pipe, and only the two public values are exported.
    #
    # /proc/PID/cmdline is 444, so an argument is readable by every account on
    # the machine. /proc/PID/environ is 400, which closes that but not the case
    # that matters here: it stays readable by every process of the same
    # account, and this watcher is meant to run for days. Anything that ever
    # executes as you, from a build script to something a package installed,
    # could read a full-rights Protect key out of it at leisure.
    #
    # A pipe is readable only while it is being read, and this one is drained
    # in the first line the watcher runs, so there is no window to come back
    # to. Process substitution rather than a here-string, because bash backs a
    # here-string with a temporary file.
    export UNIFI_WATCH_HOST="$HOST" UNIFI_WATCH_CERT="$CERT_FILE"
    # Tracing off before the exec, not inside the substitution that feeds it:
    # bash writes the whole redirection, expansions and all, before any command
    # within it runs, so an untrace in there is already too late. There is no
    # retrace because exec does not come back.
    # The system interpreter if it has websockets, otherwise the one setup put
    # aside. Nothing is installed from here: this runs on its own whenever the
    # shell starts, and a bar widget that fetches and executes a package off
    # the network at that moment is taking a trust nobody gave it. With
    # neither, python3 gets the script anyway so the import error below is
    # what the panel hears.
    WATCH_PY=python3
    if ! python3 -c 'import websockets' >/dev/null 2>&1 &&
       [[ -x "$VENV_PYTHON" ]] && "$VENV_PYTHON" -c 'import websockets' >/dev/null 2>&1; then
      WATCH_PY="$VENV_PYTHON"
    fi
    untrace
    exec "$WATCH_PY" -u -c '
import asyncio, json, os, re, ssl, sys

try:
    import websockets
except ImportError:
    print(json.dumps({
        "type": "error",
        "error": "Motion needs the python websockets package: sudo pacman -S python-websockets, or run unifi-protect setup",
    }), flush=True)
    sys.exit(1)

# First thing, before anything else can go wrong and leave it sitting there.
key = sys.stdin.readline().strip()
if not key:
    print(json.dumps({"type": "error", "error": "no api key was handed to the watcher"}), flush=True)
    sys.exit(1)
host = os.environ["UNIFI_WATCH_HOST"]
url = f"wss://{host}/proxy/protect/integration/v1/subscribe/events"

# The pinned certificate is the only one this will talk to. It is loaded as
# the trust root rather than compared after the fact, because the key travels
# in the handshake request: by the time there is a socket to inspect it has
# already gone out. Hostname checking stays off -- the certificate names the
# console, not the address -- but with a store holding exactly one certificate,
# "verified" already means "the one that was pinned".
#
# The two verify flags are what make that work against a real console. The
# gateway signs its own leaf and does not mark it a CA, and OpenSSL will not
# take a non-CA certificate as a trust anchor: X509_STRICT, which Python turns
# on by default from 3.13, rejects it outright, and PARTIAL_CHAIN is the flag
# that says any certificate in the store may anchor a chain. Without both,
# this fails as "invalid CA certificate" -- a statement about how the
# certificate was issued, not about the pin.
#
# Neither flag loosens what is being checked here. The store holds one
# certificate; a host presenting any other is still refused, including one
# that copies the name on this one.
ctx = ssl.create_default_context(cafile=os.environ["UNIFI_WATCH_CERT"])
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_REQUIRED
ctx.verify_flags &= ~ssl.VERIFY_X509_STRICT
ctx.verify_flags |= ssl.VERIFY_X509_PARTIAL_CHAIN

# Same rule as the shell side: an id that is not flat alphanumeric never
# reaches the widget, which would pass it straight back down as a path.
ID = re.compile(r"^[A-Za-z0-9]{1,64}$")


def emit(obj):
    print(json.dumps(obj), flush=True)


async def listen():
    async with websockets.connect(
        url, ssl=ctx, additional_headers={"X-API-KEY": key},
        ping_interval=30, close_timeout=5,
    ) as ws:
        emit({"type": "connected"})
        async for raw in ws:
            try:
                msg = json.loads(raw)
            except (ValueError, TypeError):
                continue
            item = msg.get("item") or {}
            kind = item.get("type") or msg.get("type")
            if kind not in ("motion", "smartDetectZone", "smartDetectLine"):
                continue
            camera = item.get("camera") or item.get("device")
            if not isinstance(camera, str) or not ID.match(camera):
                continue
            emit({
                "type": "motion",
                "camera": camera,
                "kind": kind,
                "detections": item.get("smartDetectTypes") or [],
                "ended": item.get("end") is not None,
            })


async def main():
    # Reconnect rather than exit: the widget starts this once and expects it
    # to still be there after the gateway reboots or the wifi blinks.
    delay = 1
    while True:
        try:
            await listen()
            delay = 1
        except Exception as e:
            emit({"type": "error", "error": str(e)})
            await asyncio.sleep(delay)
            delay = min(delay * 2, 60)


asyncio.run(main())
' < <(printf '%s\n' "$KEY") ;;

  setup)
    # Motion needs the python websockets package. The tidy way is the distro
    # package; this is for a machine that has none and no wish to hand a bar
    # widget sudo.
    #
    # Typed by hand, and it says what it is about to do before it does it.
    # That is the whole difference: installing something off the network is a
    # thing a person agrees to, not a thing a widget does on its own the first
    # time it starts. Human output rather than JSON, because a person is
    # reading it.
    if python3 -c 'import websockets' >/dev/null 2>&1; then
      printf 'The system python already has websockets. Nothing to do.\n'
      exit 0
    fi
    if [[ -x "$VENV_PYTHON" ]] && "$VENV_PYTHON" -c 'import websockets' >/dev/null 2>&1; then
      printf 'Already set up: %s\n' "$VENV_PYTHON"
      exit 0
    fi

    printf 'The system python has no websockets package, which is what motion\n'
    printf 'events need. On Arch the tidy way is:\n\n'
    printf '    sudo pacman -S --needed python-websockets\n\n'
    printf 'Otherwise this installs it from PyPI into a virtualenv of your own:\n\n'
    printf '    %s\n\n' "$VENV_DIR"
    printf 'Nothing outside that directory is touched and no privileges are asked\n'
    printf 'for. Remove it by deleting the directory.\n\n'

    # No terminal means nobody is there to agree, so nothing is installed.
    # The other way round, carrying on when there is no one to ask, is how a
    # command a person is supposed to type ends up running from a script.
    if [[ ! -t 0 ]]; then
      printf 'Run this in a terminal, or pass --yes if you mean it from a script.\n' >&2
      [[ "${2:-}" == "--yes" ]] || exit 1
    else
      read -r -p 'Create it and install websockets from PyPI? [y/N] ' answer
      [[ "$answer" == [yY]* ]] || { printf 'Nothing installed.\n' >&2; exit 1; }
    fi

    python3 -m venv "$VENV_DIR" ||
      { printf 'could not create %s\n' "$VENV_DIR" >&2; exit 1; }
    if command -v uv >/dev/null 2>&1; then
      uv pip install --python "$VENV_PYTHON" websockets ||
        { printf 'could not install websockets\n' >&2; exit 1; }
    else
      "$VENV_PYTHON" -m pip install websockets ||
        { printf 'could not install websockets\n' >&2; exit 1; }
    fi
    "$VENV_PYTHON" -c 'import websockets' >/dev/null 2>&1 ||
      { printf 'installed, but the import still fails\n' >&2; exit 1; }
    printf '\nDone: %s\nRestart the shell to pick it up.\n' "$VENV_PYTHON"
    ;;

  status)
    # Local only: the panel uses this to tell "needs key" from
    # "unreachable" without sending anything to the gateway. `trusted`
    # is whether a pin is already on file, not a setup gate.
    has_key=false
    [[ -n "$KEY" ]] && has_key=true
    trusted=false
    if [[ -r "$CERT_FILE" ]]; then
      pinned_fp="$(file_fingerprint "$CERT_FILE")"
      [[ -n "$pinned_fp" ]] && trusted=true
    fi
    jq -nc --arg host "$HOST" --argjson hasKey "$has_key" --argjson trusted "$trusted" \
      '{ok:true, hasKey:$hasKey, trusted:$trusted, host:$host}'
    ;;

  set-key)
    # The key arrives on stdin so it never appears in argv (or in a
    # `ps` listing). First non-blank line, trimmed — the same rule `key()`
    # reads back. The file is 0600: the umask at the top covers a new file,
    # and chmod puts a looser existing file back.
    untrace
    new_key=""
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      [[ -n "$line" ]] || continue
      new_key="$line"
      break
    done
    [[ -n "$new_key" ]] || fail "empty key"
    valid_key "$new_key" || fail "malformed API key"
    private_dir "${KEY_FILE%/*}" || fail "cannot write ${KEY_FILE%/*}"
    printf '%s\n' "$new_key" > "$KEY_FILE" || fail "cannot write $KEY_FILE"
    retrace
    chmod 600 -- "$KEY_FILE" || fail "cannot write $KEY_FILE"
    printf '{"ok":true}\n'
    ;;

  trust)
    # Look at whatever is answering on the address right now, show its
    # fingerprint so it can be held against the one the console shows
    # under Settings -> System, and file it. Ordinary use pins on first
    # contact instead; this is for looking first, or pinning again after
    # a console reset.
    #
    # `trust` on its own is the interactive terminal form. `trust show`
    # and `trust accept` are JSON for scripts: show never writes, accept
    # re-fetches and pins only if the fingerprint still matches.
    case "${2:-}" in
      show)
        command -v openssl >/dev/null 2>&1 || fail "openssl is needed to pin the certificate"
        target="$(gateway_target)"
        chain="$(fetch_chain "$target")"
        [[ -n "$chain" ]] || fail "cannot reach https://$target/ to read its certificate"
        new_fp="$(printf '%s' "$chain" | cert_fingerprint)"
        [[ -n "$new_fp" ]] || fail "that is not a certificate"
        detail() { printf '%s' "$chain" | openssl x509 -noout "$@" 2>/dev/null | cut -d= -f2-; }
        old_fp=""
        [[ -r "$CERT_FILE" ]] && old_fp="$(file_fingerprint "$CERT_FILE")"
        match=false
        if [[ -n "$old_fp" && "$(normalize_fp "$old_fp")" == "$(normalize_fp "$new_fp")" ]]; then
          match=true
        fi
        jq -nc \
          --arg fingerprint "$new_fp" \
          --arg subject "$(detail -subject)" \
          --arg expires "$(detail -enddate)" \
          --arg pinned "$old_fp" \
          --argjson match "$match" \
          '{ok:true, fingerprint:$fingerprint, subject:$subject, expires:$expires, pinned:$pinned, match:$match}'
        ;;

      accept)
        command -v openssl >/dev/null 2>&1 || fail "openssl is needed to pin the certificate"
        [[ -n "${3:-}" ]] || fail "usage: unifi-protect trust accept <sha256-fingerprint>"
        want="$(normalize_fp "$3")"
        [[ "$want" =~ ^[0-9A-F]{64}$ ]] || fail "not a sha256 fingerprint"
        target="$(gateway_target)"
        chain="$(fetch_chain "$target")"
        [[ -n "$chain" ]] || fail "cannot reach https://$target/ to read its certificate"
        new_fp="$(printf '%s' "$chain" | cert_fingerprint)"
        [[ -n "$new_fp" ]] || fail "that is not a certificate"
        got="$(normalize_fp "$new_fp")"
        [[ "$got" == "$want" ]] || fail "certificate changed before it could be pinned"
        private_dir "${CERT_FILE%/*}" || fail "cannot write ${CERT_FILE%/*}"
        (umask 077; printf '%s\n' "$chain" > "$CERT_FILE") || fail "cannot write $CERT_FILE"
        printf '{"ok":true}\n'
        ;;

      "")
        command -v openssl >/dev/null 2>&1 || {
          printf 'openssl is needed to pin the certificate\n' >&2; exit 1; }

        target="$(gateway_target)"
        chain="$(fetch_chain "$target")"
        [[ -n "$chain" ]] || {
          printf 'cannot reach https://%s/ to read its certificate\n' "$target" >&2; exit 1; }

        detail() { printf '%s' "$chain" | openssl x509 -noout "$@" 2>/dev/null | cut -d= -f2-; }
        new_fp="$(detail -fingerprint -sha256)"
        [[ -n "$new_fp" ]] || { printf 'that is not a certificate\n' >&2; exit 1; }

        printf 'Gateway    https://%s/\n' "$target"
        printf 'Subject    %s\n' "$(detail -subject)"
        printf 'Issuer     %s\n' "$(detail -issuer)"
        printf 'Expires    %s\n' "$(detail -enddate)"
        printf 'SHA-256    %s\n\n' "$new_fp"

        if [[ -r "$CERT_FILE" ]]; then
          old_fp="$(file_fingerprint "$CERT_FILE")"
          if [[ -n "$old_fp" && "$old_fp" != "$new_fp" ]]; then
            printf 'This is NOT the certificate currently pinned:\n'
            printf '  pinned   %s\n\n' "$old_fp"
            printf 'A console that was reset or reinstalled explains this. So does\n'
            printf 'something else answering on the address. Check before you agree.\n\n'
          fi
        fi

        printf 'Compare that fingerprint against the console itself before you agree:\n'
        printf 'trusting it here is the whole of what keeps your API key from being\n'
        printf 'handed to anything else that answers on this address.\n\n'

        if [[ -t 0 ]]; then
          read -r -p 'Pin this certificate? [y/N] ' answer
          [[ "$answer" == [yY]* ]] || { printf 'Nothing pinned.\n' >&2; exit 1; }
        fi

        # Same check as the cache and the archive get. This is the directory
        # the key file lives in too, and an install from before the umask
        # above was here left it at 755 -- so the first run of `trust` closes
        # it, along with anything a previous version wrote into it.
        private_dir "${CERT_FILE%/*}" || {
          printf '%s is not a directory of ours\n' "${CERT_FILE%/*}" >&2; exit 1; }
        (umask 077; printf '%s\n' "$chain" > "$CERT_FILE") || {
          printf 'cannot write %s\n' "$CERT_FILE" >&2; exit 1; }

        printf 'Pinned to %s\n' "$CERT_FILE"
        ;;

      *)
        fail "usage: unifi-protect trust [show|accept <sha256-fingerprint>]"
        ;;
    esac
    ;;

  *)
    fail "unknown command: $1"
    ;;
esac
